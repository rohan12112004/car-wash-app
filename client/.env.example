# VITE_API_URL should point to your backend Express server
# Local development: http://localhost:5000/api
# Production (Render/Railway): https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Razorpay key id for frontend checkout initialization
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# (Optional) Vercel Analytics integration
VITE_VERCEL_ANALYTICS_ID=
